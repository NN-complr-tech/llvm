# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/example_BACKEND%shlibext \
# RUN:   -run-pass=example-x86 %s -o - | FileCheck %s

--- |
  define void @small_loop() local_unnamed_addr {
  entry:
    br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %next, %loop ]
    %next = add i32 %i, 1
    %cond = icmp slt i32 %next, 4
    br i1 %cond, label %loop, label %exit
  exit:
    ret void
  }

  define void @nested_loop() local_unnamed_addr {
  entry:
    br label %outer
  outer:
    %j = phi i32 [ 0, %entry ], [ %j.next, %outer.latch ]
    br label %inner
  inner:
    %i = phi i32 [ 0, %outer ], [ %i.next, %inner ]
    %i.next = add i32 %i, 1
    %i.cond = icmp slt i32 %i.next, 3
    br i1 %i.cond, label %inner, label %outer.latch
  outer.latch:
    %j.next = add i32 %j, 1
    %j.cond = icmp slt i32 %j.next, 2
    br i1 %j.cond, label %outer, label %exit
  exit:
    ret void
  }

  define void @too_large_loop() local_unnamed_addr {
  entry:
    br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %next, %loop ]
    %next = add i32 %i, 1
    %cond = icmp slt i32 %next, 8
    br i1 %cond, label %loop, label %exit
  exit:
    ret void
  }
...

---
# CHECK-LABEL: name: small_loop
# CHECK:      $eax = XOR32rr
# CHECK-COUNT-4: TEST32rr
# CHECK:      $eax = ADD32ri8 $eax, 4
name:            small_loop
tracksRegLiveness: false
body:             |
  bb.0:
    successors: %bb.1(0x80000000)
    $eax = XOR32rr undef $eax, undef $eax, implicit-def dead $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2(0x04000000), %bb.1(0x7c000000)
    TEST32rr $eax, $eax, implicit-def dead $eflags
    $eax = ADD32ri8 $eax, 1, implicit-def dead $eflags
    CMP32ri8 $eax, 4, implicit-def $eflags
    JCC_1 %bb.2, 13, implicit killed $eflags
    JMP_1 %bb.1

  bb.2:
    RET64
...

---
# CHECK-LABEL: name: nested_loop
# CHECK-COUNT-3: MOV32rr
# CHECK-COUNT-2: TEST32rr
# CHECK:      $ecx = ADD32ri8 $ecx, 3
# CHECK:      $eax = ADD32ri8 $eax, 2
name:            nested_loop
tracksRegLiveness: false
body:             |
  bb.0:
    successors: %bb.1(0x80000000)
    $eax = XOR32rr undef $eax, undef $eax, implicit-def dead $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2(0x80000000)
    $ecx = XOR32rr undef $ecx, undef $ecx, implicit-def dead $eflags
    JMP_1 %bb.2

  bb.2:
    successors: %bb.3(0x04000000), %bb.2(0x7c000000)
    $edx = MOV32rr $ecx
    $ecx = ADD32ri8 $ecx, 1, implicit-def dead $eflags
    CMP32ri8 $ecx, 3, implicit-def $eflags
    JCC_1 %bb.3, 13, implicit killed $eflags
    JMP_1 %bb.2

  bb.3:
    successors: %bb.4(0x04000000), %bb.1(0x7c000000)
    TEST32rr $eax, $eax, implicit-def dead $eflags
    $eax = ADD32ri8 $eax, 1, implicit-def dead $eflags
    CMP32ri8 $eax, 2, implicit-def $eflags
    JCC_1 %bb.4, 13, implicit killed $eflags
    JMP_1 %bb.1

  bb.4:
    RET64
...

---
# CHECK-LABEL: name: too_large_loop
# CHECK-COUNT-1: OR32rr
# CHECK:      $eax = ADD32ri8 $eax, 1
name:            too_large_loop
tracksRegLiveness: false
body:             |
  bb.0:
    successors: %bb.1(0x80000000)
    $eax = XOR32rr undef $eax, undef $eax, implicit-def dead $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2(0x04000000), %bb.1(0x7c000000)
    $edx = OR32rr $eax, $eax, implicit-def dead $eflags
    $eax = ADD32ri8 $eax, 1, implicit-def dead $eflags
    CMP32ri8 $eax, 8, implicit-def $eflags
    JCC_1 %bb.2, 13, implicit killed $eflags
    JMP_1 %bb.1

  bb.2:
    RET64
...